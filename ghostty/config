# Ghostty config — included from ~/.config/ghostty/config (append) or symlinked (link).
# Docs: https://ghostty.org/docs/config   Validate: ghostty +validate-config

# Font (Ghostty also bundles Nerd Font symbol fallback, but this keeps glyphs consistent)
font-family = JetBrainsMono Nerd Font
font-size = 13

# Theme follows macOS light/dark appearance
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# Alt/Option as Meta: needed for fzf Alt-C and readline Alt-b/f/d
macos-option-as-alt = true

# Shell integration is auto-injected for zsh/bash. ssh-* features copy the xterm-ghostty
# terminfo to remote hosts (or fall back to xterm-256color), replacing most need for `ssh-terminfo`.
shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# Clipboard / mouse
copy-on-select = clipboard
mouse-hide-while-typing = true
clipboard-paste-protection = true

# Scrollback (bytes). tmux has its own history-limit.
scrollback-limit = 25000000

# Windows
window-save-state = always
window-padding-x = 6
window-padding-y = 4
confirm-close-surface = false
macos-titlebar-style = tabs

cursor-style = block
cursor-style-blink = false

# Native splits/tabs (tmux still preferred on remote hosts)
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
